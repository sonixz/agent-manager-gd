#!/usr/bin/env python3
"""Tests only: stands for OpenSSH toward a sandbox. It keeps a « master » alive, adds and removes forwards (a small
relay toward a port of this computer, which stands for a port of the sandbox), remembers a host key as OpenSSH
does with accept-new, and answers the two commands the carrier runs in a sandbox with texts given by the test.
Nothing leaves this computer."""
import os
import signal
import subprocess
import sys
import time

args = sys.argv[1:]
opt, flags, rest = {"-o": []}, set(), []
i = 0
while i < len(args):
    a = args[i]
    if a in ("-i", "-p", "-S", "-O", "-L"):
        opt[a] = args[i + 1]
        i += 2
    elif a == "-o":
        opt["-o"].append(args[i + 1])
        i += 2
    elif a in ("-M", "-N", "-t"):
        flags.add(a)
        i += 1
    else:
        rest = args[i:]
        break
sock = opt.get("-S", "")
pidfile = sock + ".pid"
settings = dict(o.split("=", 1) for o in opt["-o"] if "=" in o)


def alive() -> int:
    try:
        pid = int(open(pidfile).read())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return 0


def forwards() -> list:
    folder, name = os.path.dirname(sock), os.path.basename(sock)
    return [os.path.join(folder, f) for f in os.listdir(folder) if f.startswith(name + ".fwd.")]


if "-M" in flags:   # the master: check the host key as accept-new does, then stay
    known, alias, key = settings.get("UserKnownHostsFile", ""), settings.get("HostKeyAlias", "host"), os.environ.get("STANDIN_HOST_KEY", "key-one")
    line = f"{alias} ssh-ed25519 {key}"
    seen = open(known).read().splitlines() if known and os.path.exists(known) else []
    mine = [x for x in seen if x.startswith(alias + " ")]
    if mine and mine[0] != line:
        sys.stderr.write("@@@ WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED! @@@\nHost key verification failed.\n")
        sys.exit(255)
    if not mine and known:
        os.makedirs(os.path.dirname(known), exist_ok=True)
        with open(known, "a") as f:
            f.write(line + "\n")
    if os.environ.get("STANDIN_UNREACHABLE"):
        sys.stderr.write("ssh: connect to host 127.0.0.1 port %s: Connection refused\n" % opt.get("-p", "?"))
        sys.exit(255)
    with open(pidfile, "w") as f:
        f.write(str(os.getpid()))
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    while True:
        time.sleep(0.2)
elif opt.get("-O") == "check":
    sys.exit(0 if alive() else 255)
elif opt.get("-O") == "forward":
    if not alive():
        sys.exit(255)
    _, inner, _, port = opt["-L"].split(":")
    here = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
    code = ("import sys, time; sys.path.insert(0, %r); from engine.relay import Relay; r = Relay(); "
            "r.open(%d, port=%d, tries=1); time.sleep(3600)") % (here, int(port), int(inner))
    p = subprocess.Popen([sys.executable, "-c", code], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    with open(f"{sock}.fwd.{inner}", "w") as f:
        f.write(str(p.pid))
    time.sleep(0.4)   # the forward listens once the command is back, as with OpenSSH
    sys.exit(0)
elif opt.get("-O") in ("cancel", "exit"):
    which = forwards() if opt["-O"] == "exit" else [f"{sock}.fwd.{opt['-L'].split(':')[1]}"]
    for f in which:
        try:
            os.kill(int(open(f).read()), signal.SIGTERM)
            os.remove(f)
        except (OSError, ValueError):
            pass
    if opt["-O"] == "exit":
        pid = alive()
        if pid:
            os.kill(pid, signal.SIGTERM)
        try:
            os.remove(pidfile)
        except OSError:
            pass
    sys.exit(0)
else:   # a command in the sandbox
    if not alive():
        sys.exit(255)
    command = " ".join(rest[1:])
    if command.startswith("ss "):
        sys.stdout.write(open(os.environ["STANDIN_SS"]).read())
    elif command.startswith("cat /proc/meminfo"):
        sys.stdout.write(open(os.environ["STANDIN_HEALTH"]).read())
    sys.exit(0)
