#!/usr/bin/env python
# Builds the VtTerminal GDExtension against godot-cpp and libghostty-vt.
#   scons GODOT_CPP=~/src/godot-cpp GHOSTTY=~/src/ghostty/zig-out target=template_release
import os

godot_cpp = os.path.expanduser(ARGUMENTS.get("GODOT_CPP", "~/src/godot-cpp"))
ghostty = os.path.expanduser(ARGUMENTS.get("GHOSTTY", "~/src/ghostty/zig-out"))
if ARGUMENTS.get("platform") == "windows" and "GHOSTTY" not in ARGUMENTS:
    ghostty = os.path.expanduser("~/src/ghostty/zig-out-win")
out_dir = ARGUMENTS.get("OUT", "../../prototype/terminal-ghostty/addons/vtterm/bin")

env = SConscript(os.path.join(godot_cpp, "SConstruct"), {"api_version": "4.7"})
env["SHOBJSUFFIX"] = ".{}.{}.o".format(env["platform"], env["target"])  # one object set per platform
env.Append(CPPPATH=["src", os.path.join(ghostty, "include")])
env.Append(LIBPATH=[os.path.join(ghostty, "lib")])
env.Append(LIBS=["ghostty-vt"])
if env["platform"] == "windows":
    env.Append(CPPDEFINES=[("_WIN32_WINNT", "0x0A00")])
if env["platform"] == "linux":
    env.Append(LIBS=["util"], LINKFLAGS=["-Wl,-rpath,'$$ORIGIN'"])

# clang (the Windows build, through zig) emits godot-cpp's engine class registrations only where a class is used in a
# certain way, so most engine objects reaching the extension (input events…) had no binding. Register every class.
sources = Glob("src/*.cpp")
if env["platform"] == "windows":
    import re
    classes_dir = os.path.join(godot_cpp, "gen", "include", "godot_cpp", "classes")
    pairs = []
    for name in sorted(os.listdir(classes_dir)):
        if name.endswith(".hpp"):
            with open(os.path.join(classes_dir, name), encoding="utf-8") as f:
                for cls in re.findall(r"GDEXTENSION_CLASS\((\w+),", f.read()):
                    if cls not in ("Mutex", "Semaphore", "Thread"):  # wrapped differently by godot-cpp
                        pairs.append((name, cls))
    gen = os.path.join("gen", "engine_classes.windows.cpp")
    os.makedirs("gen", exist_ok=True)
    body = "// Generated by SConstruct: registers every godot-cpp engine class binding (see the comment there).\n"
    body += "".join('#include <godot_cpp/classes/%s>\n' % h for h in sorted({h for h, _ in pairs}))
    body += "\nnamespace godot {\nvoid vtterm_register_engine_classes() {\n"
    body += "".join("\tinternal::EngineClassRegistration<%s>::callback();\n" % c for _, c in pairs)
    body += "}\n}\n"
    if not os.path.exists(gen) or open(gen, encoding="utf-8").read() != body:
        with open(gen, "w", encoding="utf-8") as f:
            f.write(body)
    sources.append(File(gen))
    env.Append(CPPDEFINES=["VTTERM_REGISTER_ALL"])

lib = env.SharedLibrary(
    os.path.join(out_dir, "libvtterm{}{}".format(env["suffix"], env["SHLIBSUFFIX"])),
    sources,
)
Default(lib)
