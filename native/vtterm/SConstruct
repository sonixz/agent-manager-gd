#!/usr/bin/env python
# Builds the VtTerminal GDExtension against godot-cpp and libghostty-vt.
#   scons GODOT_CPP=~/src/godot-cpp GHOSTTY=~/src/ghostty/zig-out target=template_release
import os

godot_cpp = os.path.expanduser(ARGUMENTS.get("GODOT_CPP", "~/src/godot-cpp"))
ghostty = os.path.expanduser(ARGUMENTS.get("GHOSTTY", "~/src/ghostty/zig-out"))
if ARGUMENTS.get("platform") == "windows" and "GHOSTTY" not in ARGUMENTS:
    ghostty = os.path.expanduser("~/src/ghostty/zig-out-win")
out_dir = ARGUMENTS.get("OUT", "../../prototype/terminal-ghostty/addons/vtterm/bin")

env = SConscript(os.path.join(godot_cpp, "SConstruct"), {"api_version": "4.7"})
env["SHOBJSUFFIX"] = ".{}.{}.o".format(env["platform"], env["target"])  # one object set per platform
env.Append(CPPPATH=["src", os.path.join(ghostty, "include")])
env.Append(LIBPATH=[os.path.join(ghostty, "lib")])
env.Append(LIBS=["ghostty-vt"])
if env["platform"] == "windows":
    env.Append(CPPDEFINES=[("_WIN32_WINNT", "0x0A00")])
if env["platform"] == "linux":
    env.Append(LIBS=["util"], LINKFLAGS=["-Wl,-rpath,'$$ORIGIN'"])

lib = env.SharedLibrary(
    os.path.join(out_dir, "libvtterm{}{}".format(env["suffix"], env["SHLIBSUFFIX"])),
    Glob("src/*.cpp"),
)
Default(lib)
